# DivisasCUP — build-time configuration for the Supabase backend.
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# `.env` is gitignored, so your real keys are never committed.
#
# Read at BUILD time (not runtime) — pass the file to flutter:
#     flutter run   --dart-define-from-file=.env
#     flutter build apk --debug --dart-define-from-file=.env
#
# SECURITY: only the PUBLISHABLE key belongs in this file. It ships inside
# the APK on purpose and is safe to expose, because Row Level Security
# decides what it can reach. NEVER put an `sb_secret_...` (service_role)
# key here or anywhere in the client: it bypasses RLS and is trivially
# extracted from the binary.

# Local Supabase stack (after `supabase start`), or the cloud project URL.
#   desktop / Dart test  : http://127.0.0.1:54321
#   Android emulator     : http://10.0.2.2:54321
#   physical device (LAN): http://<your-machine-LAN-IP>:54321
#   cloud project        : https://<project-ref>.supabase.co
SUPABASE_URL=

# Printed by `supabase start`. The local one is a `sb_publishable_...` string.
SUPABASE_PUBLISHABLE_KEY=
